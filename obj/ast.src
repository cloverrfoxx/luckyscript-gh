AST.FString=function(elems,exprs)
	node=new outer.ast_t
	node.classID="FString"
	node.elems=elems
	node.exprs=exprs
	node._print=function(i=0)
		s=(" "*i)+node.classID+":"
		for part in node.elems+node.exprs
			s=s+"
"+part._print(i+2)
		end for
		return s
	end function
	return node
end function
