AST.ForState=function()
	node=new outer.ast_t
	node.classID="ForState"
	node._print=function(i=0)
		return (" "*i)+node.classID+":WIP"
	end function
	return node
end function
AST.ForInState=function(init,item,blk)
	node=new outer.ast_t
	node.classID="ForInState"
	node.init=init
	node.item=item
	node.blk=blk
	node._print=function(i=0)
		return (" "*i)+node.classID+":"+"
"+node.init._print(i+2)+"
"+node.item._print(i+2)+"
"+node.blk._print(i+2)
	end function
	return node
end function
